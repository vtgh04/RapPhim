{
  "info": {
    "_postman_id": "c1f77d34-9721-4f9e-a89c-4bf07a01cb6b",
    "name": "RapPhim API Collection",
    "description": "Bộ sưu tập các RESTful API của hệ thống RapPhim. Bao gồm các kiểm thử tự động (tests) cho luồng đăng nhập, suất chiếu, đặt vé và thanh toán.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "1. Login (Đăng nhập)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP Status 200 - Đăng nhập thành công\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Nhận được Access Token và thông tin cơ bản\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('accessToken');",
                  "    pm.expect(jsonData).to.have.property('employeeId');",
                  "    pm.expect(jsonData).to.have.property('username');",
                  "    // Lưu token vào biến môi trường dùng cho các API sau",
                  "    pm.collectionVariables.set(\"jwt_token\", jsonData.accessToken);",
                  "    pm.collectionVariables.set(\"employee_id\", jsonData.employeeId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Movies",
      "item": [
        {
          "name": "Get All Movies (Lấy tất cả phim)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP Status 200 - Lấy danh sách phim thành công\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Trả về mảng danh sách phim\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "    if (jsonData.length > 0) {",
                  "        pm.collectionVariables.set(\"first_movie_id\", jsonData[0].movieId);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/movies",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "movies"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
