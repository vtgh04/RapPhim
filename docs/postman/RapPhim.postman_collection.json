        {
          "name": "Create Showtime (Tạo suất chiếu)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP Status 201 hoặc 200\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "pm.test(\"Suất chiếu mới đã được lưu thành công\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('showtimeId');",
                  "    pm.collectionVariables.set(\"new_showtime_id\", jsonData.showtimeId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"movieId\": \"{{first_movie_id}}\",\n    \"hallId\": \"HALL01\",\n    \"startTime\": \"2026-12-31T10:00:00\",\n    \"endTime\": \"2026-12-31T12:00:00\",\n    \"basePrice\": 80000.0,\n    \"status\": \"SCHEDULED\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/showtimes",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "showtimes"
              ]
            }
          },
          "response": []
        },
