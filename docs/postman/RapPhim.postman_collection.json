    {
      "name": "Bookings",
      "item": [
        {
          "name": "Checkout Booking (Thực hiện đặt vé)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP Status 200 - Thanh toán đặt vé thành công\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Nhận được hóa đơn trả về hợp lệ\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('invoiceId');",
                  "    pm.expect(jsonData.totalTickets).to.eql(2);",
                  "    pm.collectionVariables.set(\"new_invoice_id\", jsonData.invoiceId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
